<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT p.Product_ID, SUM(p.Quantity) AS qty, SUM(p.UnitPrice * p.Quantity - p.DiscountAmount) AS revenue FROM dbo.INVOICE_PRODUCT_ITEM p JOIN dbo.INVOICE i ON i.Invoice_ID = p.Invoice_ID WHERE i.Branch_ID = 1 AND i.PaymentStatus = &apos;PAID&apos; AND i.PaidAt &gt;= &apos;2025-03-31T17:00:00&apos; AND i.PaidAt &lt; &apos;2025-06-30T17:00:00&apos; GROUP BY p.Product_ID ORDER BY revenue DESC" StatementId="1" StatementCompId="3" StatementType="SELECT" StatementSqlHandle="0x09002D99ED7CE93A4BA59957D707389EF8E20000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="8.014" StatementEstRows="200" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x629E3BE8ECE05C0B" QueryPlanHash="0x77884F58C7F1DEB5" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="36424" CachedPlanSize="96" CompileTime="6" CompileCPU="6" CompileMemory="608"><ThreadStat Branches="3" UsedThreads="24"><ThreadReservation NodeId="0" ReservedThreads="24"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="31.7516"><MissingIndex Database="[FitLife_P3_P2]" Schema="[dbo]" Table="[INVOICE]"><ColumnGroup Usage="EQUALITY"><Column Name="[Branch_ID]" ColumnId="4"></Column><Column Name="[PaymentStatus]" ColumnId="10"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="11"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="2560" SerialDesiredMemory