<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT g.PeriodStart, g.Branch_ID, g.Revenue, g.InvoiceCount,&#xa;           SUM(g.Revenue) OVER (PARTITION BY g.PeriodStart)      AS PeriodSystemRevenue,&#xa;           SUM(g.InvoiceCount) OVER (PARTITION BY g.PeriodStart) AS PeriodSystemInvoiceCount&#xa;    FROM (SELECT p.PeriodStart, i.Branch_ID, SUM(i.FinalAmount) AS Revenue, COUNT_BIG(*) AS InvoiceCount&#xa;          FROM dbo.INVOICE AS i&#xa;          CROSS APPLY dbo.tvf_P3_ReportPeriodStart(i.PaidAt, @Grain) AS p&#xa;          WHERE i.PaymentStatus = &apos;PAID&apos; AND i.PaidAt &gt;= @FromUtc AND i.PaidAt &lt; @ToUtc&#xa;          GROUP BY p.PeriodStart, i.Branch_ID) AS g&#xa;    ORDER BY g.PeriodStart, g.Branch_ID" StatementId="2" StatementCompId="14" StatementType="SELECT" StatementSqlHandle="0x09000F02750B6AB6DB9F13EA4125A74C0D680000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="2099048" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="4.80418" StatementEstRows="52882" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE76DA0D4E99170B6" QueryPlanHash="0xBCDF2AE51EC85FC1" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="12096" CachedPlanSize="96" CompileTime="11" CompileCPU="10" CompileMemory="720"><ThreadStat Branches="2" UsedThreads="16"><ThreadReservation NodeId="0" ReservedThreads="16"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="45.7529"><MissingIndex Database="[FitLife_P3_UC05L]" Schema="[dbo]" Table="[INVOICE]"><ColumnGroup Usage="EQUALITY"><Column Name="[Payme