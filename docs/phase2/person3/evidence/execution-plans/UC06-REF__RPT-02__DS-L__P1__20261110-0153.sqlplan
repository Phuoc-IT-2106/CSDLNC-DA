<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT g.Branch_ID, g.Revenue, g.InvoiceCount,&#xa;           SUM(g.Revenue) OVER ()      AS SystemRevenue,&#xa;           SUM(g.InvoiceCount) OVER () AS SystemInvoiceCount,&#xa;           CASE WHEN SUM(g.Revenue) OVER () &gt; 0&#xa;                THEN CONVERT(DECIMAL(7,2), ROUND(g.Revenue * 100 / SUM(g.Revenue) OVER (), 2)) END AS SharePct&#xa;    FROM (SELECT i.Branch_ID, SUM(i.FinalAmount) AS Revenue, COUNT_BIG(*) AS InvoiceCount&#xa;          FROM dbo.INVOICE AS i&#xa;          WHERE i.PaymentStatus = &apos;PAID&apos; AND i.PaidAt &gt;= @FromUtc AND i.PaidAt &lt; @ToUtc&#xa;          GROUP BY i.Branch_ID) AS g&#xa;    ORDER BY g.Branch_ID" StatementId="2" StatementCompId="11" StatementType="SELECT" StatementSqlHandle="0x0900B5CA6EAF6EE9B39923B04523C8CAD7A70000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="2117582582" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.44276" StatementEstRows="12" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x8B02FCF90A15F8C8" QueryPlanHash="0x80E1A17BCD5D3FE0" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1584" CachedPlanSize="72" CompileTime="6" CompileCPU="6" CompileMemory="512"><MissingIndexes><MissingIndexGroup Impact="79.942"><MissingIndex Database="[FitLife_P3_UC05L]" Schema="[dbo]" Table="[INVOICE]"><ColumnGroup Usage="EQUALITY"><Column Name="[PaymentStatus]" ColumnId="10"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="11"></Column></ColumnGroup><ColumnGroup Usage="