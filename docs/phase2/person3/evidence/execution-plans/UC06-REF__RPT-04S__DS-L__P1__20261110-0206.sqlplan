<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT g.PeriodStart, g.Branch_ID, g.Revenue, g.InvoiceCount,&#xa;           SUM(g.Revenue) OVER (PARTITION BY g.PeriodStart)      AS PeriodSystemRevenue,&#xa;           SUM(g.InvoiceCount) OVER (PARTITION BY g.PeriodStart) AS PeriodSystemInvoiceCount&#xa;    FROM (SELECT p.PeriodStart, i.Branch_ID, SUM(i.FinalAmount) AS Revenue, COUNT_BIG(*) AS InvoiceCount&#xa;          FROM dbo.INVOICE AS i&#xa;          CROSS APPLY dbo.tvf_P3_ReportPeriodStart(i.PaidAt, @Grain) AS p&#xa;          WHERE i.PaymentStatus = &apos;PAID&apos; AND i.PaidAt &gt;= @FromUtc AND i.PaidAt &lt; @ToUtc&#xa;          GROUP BY p.PeriodStart, i.Branch_ID) AS g&#xa;    ORDER BY g.PeriodStart, g.Branch_ID" StatementId="2" StatementCompId="14" StatementType="SELECT" StatementSqlHandle="0x09000F02750B6AB6DB9F13EA4125A74C0D680000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="2099048" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="4.80418" StatementEstRows="52882" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE76DA0D4E99170B6" QueryPlanHash="0xBCDF2AE51EC85FC1" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="18240" CachedPlanSize="96" CompileTime="15" CompileCPU="15" CompileMemory="720"><ThreadStat Branches="2" UsedThreads="16"><ThreadReservation NodeId="0" ReservedThreads="16"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="45.7529"><MissingIndex Database="[FitLife_P3_UC05L]" Schema="[dbo]" Table="[INVOICE]"><ColumnGroup Usage="EQUALITY"><Column Name="[PaymentStatus]" ColumnId="10"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[PaidAt]" ColumnId="11"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[Branch_ID]" ColumnId="4"></Column><Column Name="[FinalAmount]" ColumnId="8"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="6656" RequiredMemory="12096" DesiredMemory="18240" RequestedMemory="18240" GrantWaitTime="0" MaxQueryMemory="203488" GrantedMemory="18240" MaxUsedMemory="14080"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="101309" EstimatedPagesCached="50654" EstimatedAvailableDegreeOfParallelism="4" MaxCompileMemory="497496"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-09T23:40:47.27" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000B_52593CB8]" Table="[INVOICE]" Schema="[dbo]" Database="[FitLife_P3_UC05L]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-10T08:48:34.90" ModificationCount="0" SamplingPercent="37.7071" Statistics="[_WA_Sys_00000004_52593CB8]" Table="[INVOICE]" Schema="[dbo]" Database="[FitLife_P3_UC05L]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-09T23:40:47.04" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_0000000A_52593CB8]" Table="[INVOICE]" Schema="[dbo]" Database="[FitLife_P3_UC05L]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="CXPACKET" WaitTimeMs="703" WaitCount="443"></Wait><Wait WaitType="SOS_SCHEDULER_YIELD" WaitTimeMs="530" WaitCount="337"></Wait><Wait WaitType="CXSYNC_PORT" WaitTimeMs="403" WaitCount="42"></Wait><Wait WaitType="IO_COMPLETION" WaitTimeMs="21" WaitCount="73"></Wait><Wait WaitType="LATCH_EX" WaitTimeMs="12" WaitCount="7"></Wait><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="9" WaitCount="2162"></Wait><Wait WaitType="CXSYNC_CONSUMER" WaitTimeMs="2" WaitCount="14"></Wai